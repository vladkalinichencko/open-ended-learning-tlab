# окружение
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.ipynb_checkpoints/

# логгеры
wandb/
.hydra/
outputs/

# скачанные данные и внешний код
datasets/*
ext/*
!datasets/.gitkeep
!datasets/*.json
!ext/.gitkeep

# тяжёлые веса; код, логи, tmp, HTML и рисунки остаются в git
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# секреты
.env
*.key

# тяжёлые артефакты jaxued
checkpoints/

# mlflow (локальный трекинг)
mlflow.db
mlruns/
mlartifacts/

# logs/, results/, runs/ и tmp/ содержат доказательства и отслеживаются

# служебные инструкции агентов
AGENTS.md
CLAUDE.md

# сырые дампы роллаутов: DIAGNOSTICS.html self-contained, агрегаты вшиты внутрь
runs/**/rollout.json
runs/**/heldout_rollouts.npz

# чекпойнты не идут в git целиком, кроме требуемых заданием
!checkpoints/
checkpoints/*
!checkpoints/submission/

# веса внутри runs: они дублируют checkpoints/submission
runs/**/*.msgpack
runs/**/checkpoints/
runs/**/*.npz

# автоматизация и wiring-проверки: проверяющим не нужны
tmp/

# автоматизация прогонов и локальные заглушки: проверяющим не нужны
run_short.sh
run_triage.sh
run_teacher_variants.sh
build_explainer.py
wandb_shim/
setup.sh
run_full.sh

# журнал работы и вспомогательные скрипты: проверяющему не нужны
NOTES.md
tmp/
